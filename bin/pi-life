#!/usr/bin/env bash
# Compatibility shim: pi-life is now pi-vida (one release).
set -euo pipefail
printf 'pi-life is now pi-vida\n' >&2
src="${BASH_SOURCE[0]}"
while [[ -L "${src}" ]]; do
  dir="$(cd "$(dirname "${src}")" && pwd)"
  src="$(readlink "${src}")"
  [[ "${src}" != /* ]] && src="${dir}/${src}"
done
exec "$(cd "$(dirname "${src}")" && pwd)/pi-vida" "$@"
