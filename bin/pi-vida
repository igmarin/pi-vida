#!/usr/bin/env bash
# pi-vida entrypoint. Prefers the Rust launcher when it has been built
# (`just build` -> crates/pi-vida/target/release/pi-vida); otherwise falls
# back to the bash launcher. `just smoke` runs through this file and must
# stay green in both states.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [[ -L "${src}" ]]; do
  dir="$(cd "$(dirname "${src}")" && pwd)"
  src="$(readlink "${src}")"
  [[ "${src}" != /* ]] && src="${dir}/${src}"
done
root="$(cd "$(dirname "${src}")/.." && pwd)"
built="${root}/crates/pi-vida/target/release/pi-vida"
if [[ -x "${built}" ]]; then
  exec "${built}" "$@"
fi
exec "${root}/libexec/pi-vida-launch" "$@"
