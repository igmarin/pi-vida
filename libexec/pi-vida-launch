#!/usr/bin/env bash
# Launch a Pi harness vida from the target repo (cwd).
# INV-skills: -e damage-control-continue, always --no-skills, then --skill for allowlisted paths only.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pi-vida [--dry-run] <vida> [solo|chain|team|fusion <stack.yaml>]
       pi-vida doctor [vida]
       pi-vida doctor-probe
       pi-vida agents <vida>
       pi-vida --dump-overlay <cwd>
       pi-vida --help

Vidas: rust | elixir | ruby | python
Aliases: phoenix → elixir, rails → ruby

  solo   daily stack (default)
  chain  plan-build-review
  team   dispatcher
  fusion multi-model stack (2-5 slots; see stacks/model-stack-trio.yaml)
  doctor this machine + cwd overlay (optional vida checks its packs)

Harness root: PI_VIDA_HOME, else PI_LIFE_HOME, else MY_PI_AGENT_HOME, else the directory that contains this script.
Skills root: PI_SKILLS_HOME or ~/.agents/skills.
Run from the target repo. Does not require a justfile there.
EOF
}

# Issue #13: prefix each line of $1 with 'warning: ' on stderr (matches the
# rest of pi-vida, which writes diagnostics to stderr). Multi-line input is
# prefixed line by line.
doctor_warn() {
  printf '%s\n' "$1" | sed 's/^/warning: /' >&2
}

# Issue #18: required core.excludesfile patterns
REQUIRED_EXCLUDES=("node_modules" ".pi/agent-sessions/" ".env" "graphify-out/" ".codegraph/")

# Probe git's core.excludesfile in the cwd.
# Returns 0 if the file exists and contains every REQUIRED_EXCLUDES pattern.
# Returns 1 if the file is missing or any required pattern is absent.
# Read-only: never writes to disk or git config.
check_excludesfile() {
  local path
  path="$(git config --get core.excludesfile 2>/dev/null || true)"
  if [[ -z "${path}" || ! -f "${path}" ]]; then
    printf 'excludesfile: %s missing patterns: %s\n' "${path:-<unset>}" "$(IFS=,; echo "${REQUIRED_EXCLUDES[*]}")"
    return 1
  fi
  local missing=()
  local pat
  for pat in "${REQUIRED_EXCLUDES[@]}"; do
    grep -Fxq -- "${pat}" "${path}" || missing+=("${pat}")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'excludesfile: %s missing patterns: %s\n' "${path}" "$(IFS=,; echo "${missing[*]}")"
    return 1
  fi
  printf 'excludesfile: %s ok\n' "${path}"
  return 0
}

# doctor <vida> preflight for one profile. strict=1 fails closed (exit 2) on
# missing mantra/tracker paths and malformed manifests — the same contract
# the launcher enforces. strict=0 (bare `doctor` sweep over every profile)
# accumulates gaps into the caller's `sweep_missing` map instead of warning
# per life — the same mantra skill is required by every vida, so per-vida
# warnings would repeat it. Mutates `optional` and `sweep_missing` via bash
# dynamic scope.
doctor_check_life() {
  local life="$1" strict="$2" skills_home="$3" root="$4"
  local doc_profile="${root}/profiles/${life}.yaml"
  if [[ ! -f "${doc_profile}" ]]; then
    if [[ "${strict}" -eq 1 ]]; then
      printf 'pi-vida: missing profile %s\n' "${doc_profile}" >&2
      exit 2
    fi
    return 0
  fi
  local kind name
  local profile_out profile_rc=0
  profile_out="$(read_profile "${doc_profile}" "${root}")" || profile_rc=$?
  if [[ "${profile_rc}" -ne 0 ]]; then
    # Malformed profile YAML: fail closed in both modes — a broken profile
    # breaks launches, not just doctor.
    exit 2
  fi
  # read_profile prints "kind\tname" rows for mantra/pack/tracker.
  # Mantra/tracker paths are launch-required (fail closed, exit 2 —
  # same message add_named_skill prints), so doctor prefights them;
  # packs only warn.
  while IFS=$'\t' read -r kind name; do
    [[ -z "${kind}" ]] && continue
    case "${kind}" in
      mantra|tracker)
        if [[ ! -e "${skills_home}/${name}" ]]; then
          if [[ "${strict}" -eq 1 ]]; then
            printf 'pi-vida: missing required %s %s (%s)\n' "${kind}" "${name}" "${skills_home}/${name}" >&2
            exit 2
          fi
          sweep_missing["${kind} ${name}"]+="${life} "
        fi
        ;;
      pack)
        local pack_status=0
        resolve_pack_paths "${skills_home}" "${name}" >/dev/null || pack_status=$?
        [[ "$pack_status" -eq 2 ]] && exit 2
        if [[ "$pack_status" -ne 0 ]]; then
          if [[ "${strict}" -eq 1 ]]; then
            doctor_warn "missing pack ${name} (${skills_home}/${name})"
            optional=$((optional + 1))
          else
            sweep_missing["pack ${name}"]+="${life} "
          fi
        fi
        ;;
    esac
  done <<< "${profile_out}"
}

# Real path of this script after following symlinks. Always resolves to the
# actual checkout — unlike resolve_root it ignores PI_VIDA_HOME / PI_LIFE_HOME / MY_PI_AGENT_HOME, so
# extension modules load from the harness even when the root is overridden.
real_script_path() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "${src}" ]]; do
    local dir
    dir="$(cd "$(dirname "${src}")" && pwd)"
    src="$(readlink "${src}")"
    [[ "${src}" != /* ]] && src="${dir}/${src}"
  done
  printf '%s\n' "${src}"
}

resolve_root() {
  if [[ -n "${PI_VIDA_HOME:-}" ]]; then
    printf '%s\n' "${PI_VIDA_HOME}"
    return
  fi
  if [[ -n "${PI_LIFE_HOME:-}" ]]; then
    printf '%s\n' "${PI_LIFE_HOME}"
    return
  fi
  if [[ -n "${MY_PI_AGENT_HOME:-}" ]]; then
    printf '%s\n' "${MY_PI_AGENT_HOME}"
    return
  fi
  cd "$(dirname "$(real_script_path)")/.." && pwd
}

canonical_life() {
  case "${1}" in
    rust) printf '%s\n' rust ;;
    elixir|phoenix) printf '%s\n' elixir ;;
    ruby|rails) printf '%s\n' ruby ;;
    python) printf '%s\n' python ;;
    rails-python)
      printf 'pi-vida: rails-python is not a vida; use ruby or python\n' >&2
      return 2
      ;;
    ecto)
      printf 'pi-vida: ecto is not a vida; use elixir\n' >&2
      return 2
      ;;
    *) return 1 ;;
  esac
}

# One Bun parse. Prints "kind<TAB>name" rows. Exit 2 on invalid YAML.
read_profile() {
  local file="$1" root="$2"
  # capabilities.ts is resolved from the script's real location (not $root):
  # PI_VIDA_HOME / PI_LIFE_HOME / MY_PI_AGENT_HOME overrides make root point at custom profile scaffolds
  # that have no extensions/ directory. Same rule as read_overlay.
  local caps_module
  caps_module="$(cd "$(dirname "$(real_script_path)")/.." && pwd)/extensions/capabilities.ts"
  (
    cd "${root}"
    # Role-map validation is shared with capabilities.ts (asRoleMap/asThinkingMap)
    # so profiles, overlays, and the env payload enforce one contract.
    CAPS_MODULE="${caps_module}" bun -e '
      import { parse } from "yaml";
      import { readFileSync } from "node:fs";
      let doc;
      try {
        doc = parse(readFileSync(process.argv[1], "utf8"));
      } catch (e) {
        console.error("pi-vida: invalid profile YAML: " + (e instanceof Error ? e.message : String(e)));
        process.exit(2);
      }
      if (doc == null || typeof doc !== "object" || Array.isArray(doc)) {
        console.error("pi-vida: invalid profile YAML: expected a mapping");
        process.exit(2);
      }
      const named = (k) => {
        const v = doc[k];
        if (v == null) return null;
        if (typeof v !== "string") {
          console.error("pi-vida: invalid profile YAML: " + k + " must be a string");
          process.exit(2);
        }
        return v;
      };
      const vidaName = named("vida");
      const lifeName = named("life");
      if (vidaName != null && lifeName != null && vidaName !== lifeName) {
        console.error("pi-vida: invalid profile YAML: vida and life both set and differ");
        process.exit(2);
      }
      const list = (k) => {
        const v = doc[k];
        if (v == null) return [];
        const arr = Array.isArray(v) ? v : [v];
        const out = [];
        for (const item of arr) {
          if (typeof item !== "string") {
            console.error("pi-vida: invalid profile YAML: " + k + " must be a string or list of strings");
            process.exit(2);
          }
          if (item) out.push(item);
        }
        return out;
      };
      for (const n of list("mantra")) console.log("mantra\t" + n);
      for (const n of list("packs")) console.log("pack\t" + n);
      const tracker = list("tracker")[0];
      if (tracker && tracker !== "none") console.log("tracker\t" + tracker);
      // Issue #15: optional per-role model/thinking defaults. Row format is
      // "kind\trole\tvalue" so the two-column skill rows stay unchanged.
      try {
        const { asRoleMap, asThinkingMap } = await import(process.env.CAPS_MODULE);
        const maps = [
          ["models", asRoleMap(doc.models, "models", "pi-vida: invalid profile YAML")],
          ["thinking", asThinkingMap(doc.thinking, "thinking", "pi-vida: invalid profile YAML")],
        ];
        for (const [k, map] of maps) {
          if (!map) continue;
          for (const [role, val] of Object.entries(map)) {
            console.log(k + "\t" + role + "\t" + val);
          }
        }
      } catch (e) {
        console.error(e instanceof Error ? e.message : String(e));
        process.exit(2);
      }
    ' "${file}"
  )
}

# Issue #11: read the project overlay (<cwd>/.pi/capabilities.yaml), if present,
# and print it as a single JSON line on stdout. Missing file = all off (print
# EMPTY_OVERLAY). Malformed YAML or schema = exit 2 (fail closed per issue).
#
# The script path is resolved from BASH_SOURCE[0] so PI_VIDA_HOME / PI_LIFE_HOME / MY_PI_AGENT_HOME overrides
# (used in tests to point at a custom profiles/ dir) do not break the import.
# The module specifier is passed via env var (OVERLAY_MODULE) so paths with
# single quotes or other JS-significant characters are safe.
# The cwd is resolved to an absolute path before the subshell cd's, so
# `--dump-overlay .` (or any relative path) finds the caller's overlay,
# not the harness's.
read_overlay() {
  local cwd_raw="$1"
  local cwd
  cwd="$(cd "${cwd_raw}" 2>/dev/null && pwd)" || {
    printf 'pi-vida: --dump-overlay cwd does not exist: %s\n' "${cwd_raw}" >&2
    return 2
  }
  local script
  script="$(cd "$(dirname "$(real_script_path)")/.." && pwd)/extensions/capabilities.ts"
  # Fast path: no overlay file = all off. Avoids the bun spawn on the common
  # no-overlay launch. EMPTY_OVERLAY is the canonical all-off payload; the
  # bun path below produces the same value for verification.
  if [[ ! -f "${cwd}/.pi/capabilities.yaml" ]]; then
    printf '%s\n' '{"capabilities":{"graphify":false,"codegraph":false,"serena":false,"rs-guard":false,"obscura":false,"playwright":false},"extraSkills":[],"trackerSkill":null}'
    return 0
  fi
  (
    cd "$(dirname "${script}")/.."
    OVERLAY_MODULE="${script}" bun -e '
      import { parse } from "yaml";
      import { readFileSync } from "node:fs";
      const mod = await import(process.env.OVERLAY_MODULE);
      const { serializeOverlayEnv, parseOverlayDoc, OverlayParseError } = mod;
      const cwd = process.argv[1];
      const overlayPath = `${cwd}/.pi/capabilities.yaml`;
      let doc;
      try {
        doc = parse(readFileSync(overlayPath, "utf8"));
      } catch (e) {
        console.error("pi-vida: invalid overlay YAML: " + (e instanceof Error ? e.message : String(e)));
        process.exit(2);
      }
      let overlay;
      try {
        overlay = parseOverlayDoc(doc);
      } catch (e) {
        if (e instanceof OverlayParseError) {
          console.error("pi-vida: " + e.message);
          process.exit(2);
        }
        throw e;
      }
      process.stdout.write(serializeOverlayEnv(overlay) + "\n");
    ' "${cwd}"
  )
}

# Resolve an installed pack's explicit manifest entries; legacy directory installs
# remain supported when the manifest has no entries for that pack.
resolve_pack_paths() {
  local skills_home="$1" name="$2" status=0
  if [[ -f "${skills_home}/.dotskills-manifest.json" ]]; then
    bun "$(cd "$(dirname "$(real_script_path)")/.." && pwd)/extensions/installed-skills.ts" "${skills_home}" "${name}" || status=$?
    # 0 = resolved entries; 1 = no entries for this pack (legacy fallback).
    # Anything else (2 = invalid manifest, or bun itself failed) fails closed.
    [[ "$status" -eq 0 ]] && return 0
    [[ "$status" -eq 1 ]] || return 2
  fi
  [[ -e "${skills_home}/${name}" ]] || return 1
  printf '%s\n' "${skills_home}/${name}"
}

# Globals: skill_names, pi_args
# required=1 fail closed; required=0 warn and continue
add_named_skill() {
  local required="$1" kind="$2" name="$3" skills_home="$4"
  [[ -z "${name}" ]] && return 0
  case " ${skill_names} " in
    *" ${name} "*) return 0 ;;
  esac
  skill_names="${skill_names} ${name}"

  local path="${skills_home}/${name}"
  if [[ "${kind}" == "pack" ]]; then
    local resolved status=0 existing duplicate
    resolved="$(resolve_pack_paths "${skills_home}" "${name}")" || status=$?
    [[ "$status" -eq 2 ]] && exit 2
    if [[ "$status" -eq 0 ]]; then
      while IFS= read -r resolved_path; do
        duplicate=0
        for existing in "${pi_args[@]}"; do
          [[ "$existing" == "$resolved_path" ]] && duplicate=1
        done
        [[ "$duplicate" -eq 1 ]] || pi_args+=(--skill "$resolved_path")
      done <<<"${resolved}"
      return 0
    fi
  fi
  if [[ -e "${path}" ]]; then
    pi_args+=(--skill "${path}")
    return 0
  fi
  if [[ "${required}" -eq 1 ]]; then
    printf 'pi-vida: missing required %s %s (%s)\n' "${kind}" "${name}" "${path}" >&2
    exit 2
  fi
  printf 'pi-vida: warning: missing %s %s (%s)\n' "${kind}" "${name}" "${path}" >&2
}

# Issue #11: add a skill path that came from the overlay (extra_skills or
# tracker.skill). These are local paths, resolved relative to the target repo
# cwd. They are always optional (warn, don't fail) because the overlay is
# per-repo and may point to paths that haven't been created yet.
add_overlay_skill() {
  local kind="$1" path="$2"
  [[ -z "${path}" ]] && return 0
  if [[ -e "${path}" ]]; then
    pi_args+=(--skill "${path}")
    return 0
  fi
  printf 'pi-vida: warning: missing overlay %s (%s)\n' "${kind}" "${path}" >&2
}

# Issue #11 + #15: read PI_OVERLAY (set by launch_life) once and print both
# the overlay skill paths and the solo role's model/thinking as
# "kind\tvalue" rows. One bun spawn for all overlay-derived launch args.
# Empty output = nothing configured. Non-zero exit fails the caller closed.
overlay_extras() {
  local overlay_cwd="$1"
  local script
  script="$(cd "$(dirname "$(real_script_path)")/.." && pwd)/extensions/capabilities.ts"
  (
    cd "$(dirname "${script}")/.."
    OVERLAY_MODULE="${script}" OVERLAY_CWD="${overlay_cwd}" bun -e '
      const { isAbsolute, join } = await import("node:path");
      const mod = await import(process.env.OVERLAY_MODULE);
      const { deserializeOverlayEnv } = mod;
      const overlay = deserializeOverlayEnv(process.env.PI_OVERLAY || "");
      const cwd = process.env.OVERLAY_CWD;
      const resolve = (p) => isAbsolute(p) ? p : join(cwd, p);
      for (const s of overlay.extraSkills) process.stdout.write("skill\t" + resolve(s) + "\n");
      if (overlay.trackerSkill) process.stdout.write("skill\t" + resolve(overlay.trackerSkill) + "\n");
      const soloModel = overlay.models?.solo;
      const soloThinking = overlay.thinking?.solo;
      if (soloModel) process.stdout.write("model\t" + soloModel + "\n");
      if (soloThinking) process.stdout.write("thinking\t" + soloThinking + "\n");
    '
  )
}

# Issue #11 live merge: fold profile models:/thinking: role maps (passed as
# PI_PROFILE_ROWS, the raw read_profile TSV) under the overlay payload on
# argv — the overlay wins per role. Prints the merged JSON for PI_OVERLAY.
merge_overlay_roles() {
  local script
  script="$(cd "$(dirname "$(real_script_path)")/.." && pwd)/extensions/capabilities.ts"
  (
    cd "$(dirname "${script}")/.."
    OVERLAY_MODULE="${script}" bun -e '
      const mod = await import(process.env.OVERLAY_MODULE);
      const { deserializeOverlayEnv, serializeOverlayEnv, mergeRoleMaps } = mod;
      const overlay = deserializeOverlayEnv(process.argv[1]);
      const models = {}, thinking = {};
      for (const line of (process.env.PI_PROFILE_ROWS || "").split("\n")) {
        const [kind, role, value] = line.split("\t");
        if (kind === "models") models[role] = value;
        if (kind === "thinking") thinking[role] = value;
      }
      process.stdout.write(serializeOverlayEnv(mergeRoleMaps(overlay, models, thinking)) + "\n");
    ' "$1"
  )
}

# Globals set: pi_args skill_names solo_model solo_thinking. Extracted from
# launch_life (issue #81) so `pi-vida agents` resolves skills/overlay through
# the exact same code path launch does — same resolver by construction, not a
# copy. mode: solo | chain | team | fusion (mode-specific -e flags included;
# fusion reads the caller-set global fusion_stack_used).
collect_launch_args() {
  local root="$1" life="$2" mode="$3"
  local profile="${root}/profiles/${life}.yaml"
  if [[ ! -f "${profile}" ]]; then
    printf 'pi-vida: missing profile %s\n' "${profile}" >&2
    exit 2
  fi

  if ! command -v bun >/dev/null 2>&1; then
    printf 'pi-vida: bun not found on PATH (needed to read YAML profiles)\n' >&2
    exit 2
  fi

  local skills_home="${PI_SKILLS_HOME:-${HOME}/.agents/skills}"
  skill_names=""
  # Issue #79: PI_VIDA_WORKER marks a Herdr member pane started by
  # start_herdr_team. Member base: damage-control + capabilities +
  # team-member + --no-skills. No boot-config (skips the first-launch
  # wizard — the primary already owns overlay setup), no clarify-gate
  # (workers, not a second clarify ritual), no status-line/agent-team.
  if [[ -n "${PI_VIDA_WORKER:-}" ]]; then
    pi_args=()
    local mb
    while IFS= read -r mb; do
      pi_args+=("${mb}")
    done <<< "$(member_base_args "${root}")"
    return 0
  fi
  # Issue #15: boot-config runs BEFORE capabilities so its first-launch TUI
  # can update PI_OVERLAY in the same session (handler order = -e order).
  pi_args=(-e "${root}/extensions/damage-control-continue.ts" -e "${root}/extensions/boot-config.ts" -e "${root}/extensions/capabilities.ts" -e "${root}/extensions/clarify-gate.ts" --no-skills -e "${root}/extensions/agents-view.ts")
  if [[ "${mode}" == "solo" ]]; then
    pi_args+=(-e "${root}/extensions/status-line.ts")
  fi
  # Issue #8: team mode = dispatcher-only primary. Mutually exclusive with
  # chain (agent-chain.ts) and tilldone (status-line.ts) by construction: this
  # launcher never loads those in team mode, so setActiveTools cannot conflict.
  if [[ "${mode}" == "team" ]]; then
    pi_args+=(-e "${root}/extensions/agent-team.ts")
  fi
  # Chain mode loads the /chain + /chain-list commands and the run_chain tool.
  # Mutually exclusive with team (agent-team.ts) and tilldone (status-line.ts)
  # by launcher construction; the extensions themselves can still be stacked
  # manually with pi -e if a session ever needs both surfaces.
  if [[ "${mode}" == "chain" ]]; then
    pi_args+=(-e "${root}/extensions/agent-chain.ts")
  fi
  # Fusion mode loads the vendored multi-model extension. The stack file
  # must exist; the extension itself validates slots, auth, and provider
  # visibility at startup. Modes are exclusive by construction.
  if [[ "${mode}" == "fusion" ]]; then
    if [[ ! -f "${fusion_stack_used:-}" ]]; then
      printf 'pi-vida: fusion stack not found: %s\n' "${fusion_stack_used:-}" >&2
      exit 2
    fi
    pi_args+=(-e "${root}/extensions/fusion-harness/fusion-harness.ts" --fh-config "${fusion_stack_used:-}")
  fi

  local rows
  rows="$(read_profile "${profile}" "${root}")" || exit 2
  local kind name value
  local profile_solo_model="" profile_solo_thinking=""
  while IFS=$'\t' read -r kind name value; do
    [[ -z "${kind}" ]] && continue
    case "${kind}" in
      mantra) add_named_skill 1 mantra "${name}" "${skills_home}" ;;
      pack) add_named_skill 0 pack "${name}" "${skills_home}" ;;
      tracker) add_named_skill 1 tracker "${name}" "${skills_home}" ;;
      models) [[ "${name}" == "solo" && -n "${value}" ]] && profile_solo_model="${value}" ;;
      thinking) [[ "${name}" == "solo" && -n "${value}" ]] && profile_solo_thinking="${value}" ;;
    esac
  done <<<"${rows}"

  # Issue #11: read the project overlay and export it to the capabilities
  # extension as PI_OVERLAY. Missing file = empty overlay; bad YAML = exit 2.
  local overlay
  overlay="$(read_overlay "${PWD}")" || exit 2
  # Live merge: profile models:/thinking: become the base under the overlay's
  # role maps so PI_OVERLAY carries child-dispatch defaults even with no
  # project overlay (or a wizard-written one that lacks the roles).
  if grep -qE '^(models|thinking)'$'\t' <<<"${rows}"; then
    overlay="$(PI_PROFILE_ROWS="${rows}" merge_overlay_roles "${overlay}")" || exit 2
    # serializeOverlayEnv always emits JSON; empty stdout would silently
    # collapse PI_OVERLAY to the empty overlay — fail closed instead.
    [[ -n "${overlay}" ]] || exit 2
  fi
  export PI_OVERLAY="${overlay}"
  export PI_VIDA_HOME="${root}"
  export PI_VIDA="${life}"
  export MY_PI_AGENT_HOME="${root}"
  export PI_LIFE="${life}"

  # Issue #15: tell the boot-config TUI whether the overlay file exists.
  # read_overlay's fast path cannot distinguish "missing" from "all off", so
  # the existence signal is a separate file check.
  if [[ -f "${PWD}/.pi/capabilities.yaml" ]]; then
    export PI_OVERLAY_EXISTS=1
  else
    # File-authoritative: a stale inherited flag must not suppress the
    # first-launch wizard when the overlay is absent.
    unset PI_OVERLAY_EXISTS
  fi

  # Issue #15: --model/--thinking for the primary session. Profile defaults
  # apply when set; an existing overlay's solo role overrides the profile.
  # Issue #11: overlay-defined skills (extra_skills + tracker.skill) become
  # --skill arguments so the model can actually use them, not just see them
  # in the prompt. Paths are resolved relative to $PWD; missing paths warn
  # (per-repo overlay is a per-project opt-in, not a fail-closed requirement).
  # One captured overlay_extras call serves all three: the command substitution
  # (not a process substitution) is what makes a failed bun spawn fail the
  # launch closed instead of silently dropping overlay-derived args.
  solo_model="${profile_solo_model}" solo_thinking="${profile_solo_thinking}"
  local extras=""
  if [[ "${PI_OVERLAY_EXISTS:-}" == "1" ]]; then
    extras="$(overlay_extras "${PWD}")" || exit 2
  fi
  local extras_kind extras_value
  while IFS=$'\t' read -r extras_kind extras_value; do
    [[ -z "${extras_kind}" ]] && continue
    case "${extras_kind}" in
      skill) add_overlay_skill overlay "${extras_value}" ;;
      model) solo_model="${extras_value}" ;;
      thinking) solo_thinking="${extras_value}" ;;
    esac
  done <<<"${extras}"
}

# Member base argv (issue #79): damage-control + capabilities + team-member
# + --no-skills. No boot-config (the primary owns overlay setup), no
# clarify-gate (workers, not a second clarify ritual), no status-line, no
# agent-team. Shared by collect_launch_args (PI_VIDA_WORKER sessions) and
# member_launch_line (dry-run print) so the contract lives once.
member_base_args() {
  printf '%s\n' \
    "-e" "${1}/extensions/damage-control-continue.ts" \
    "-e" "${1}/extensions/capabilities.ts" \
    "-e" "${1}/extensions/team-member.ts" \
    "--no-skills"
}

# Dry-run print of the member argv (issue #79). A member runs
# `pi-vida <vida> solo` — it resolves models.solo/thinking.solo from the
# merged PI_OVERLAY like any solo session (per-member role maps are a
# dispatch-time concern of agent-team.ts, not a member-launch flag).
member_launch_line() {
  local root="$1" life="$2"
  local -a member_args=()
  local arg
  while IFS= read -r arg; do
    member_args+=("${arg}")
  done <<< "$(member_base_args "${root}")"
  printf 'pi'
  for arg in "${member_args[@]}"; do
    printf ' %q' "${arg}"
  done
  printf ' pi-vida %s solo' "${life}"
}

# Issue #79 (INV-herdr): split one pane per team member and start a solo
# pi-vida in each. Layout is deterministic, not probed: member 1 splits from
# the current pane to the RIGHT, every following member splits the previous
# member's pane DOWNWARD — a left column of members next to the dispatcher.
# ponytail: per-pane layout probing only if panes end up unusable.
# Env contract for the primary: PI_HERDR_MEMBERS (comma list) so
# dispatch_agent prompts only these. On any failure: print stderr, exit 2,
# leave created panes open (the user may want them), never fall back to
# hidden spawn. Dry-run prints the member lines to stderr and makes no herdr
# calls (keeps `just smoke` executable inside Herdr).
start_herdr_team() {
  local root="$1" life="$2"
  # Resolve members via the same agents-view the inspector uses — the
  # active team (PI_TEAM, else default, else first). Resolver failures
  # propagate (a malformed config is a launch failure, not "no team");
  # a clean "team: none" is the fail-closed no-active-team case.
  local members_raw resolver_err
  resolver_err="$(mktemp)"
  members_raw="$(bun "${root}/extensions/agents-view.ts" "${PWD}" "${life}" 2>"${resolver_err}" | grep -E '^members: ' | sed 's/^members: //')"
  local resolver_rc=$?
  if [[ "${resolver_rc}" -ne 0 ]]; then
    cat "${resolver_err}" >&2
    rm -f "${resolver_err}"
    exit 2
  fi
  rm -f "${resolver_err}"
  if [[ -z "${members_raw}" ]]; then
    printf 'pi-vida: no active team (no agent-chain.yaml with teams:) — cannot start herdr member panes\n' >&2
    exit 2
  fi
  local -a members
  IFS=',' read -ra members <<< "${members_raw}"
  local member i
  for i in "${!members[@]}"; do
    members[i]="${members[i]//[[:space:]]/}"
  done

  if [[ "${dry_run}" -eq 1 ]]; then
    # Dry-run makes no herdr calls and does not require the binary, so
    # `just smoke` stays executable on machines without herdr.
    for member in "${members[@]}"; do
      printf 'pi-vida: herdr: agent start %s --kind pi -- ' "${member}" >&2
      member_launch_line "${root}" "${life}" >&2
      printf '\n' >&2
    done
    export PI_HERDR_MEMBERS="$(IFS=,; echo "${members[*]}")"
    return 0
  fi

  if ! command -v herdr >/dev/null 2>&1; then
    printf 'pi-vida: herdr not found on PATH (required for team mode inside Herdr)\n' >&2
    exit 2
  fi

  local prev_pane="--current" direction="right"
  local pane_id out
  for member in "${members[@]}"; do
    out="$(herdr pane split "${prev_pane}" --direction "${direction}" --ratio 0.5 --cwd "${PWD}" --env "PI_VIDA_WORKER=${member}" --no-focus 2>&1)" || {
      printf 'pi-vida: herdr pane split failed for %s: %s\n' "${member}" "${out}" >&2
      exit 2
    }
    pane_id="$(PI_VIDA_HERDR_JSON="${out}" bun -e '
      try {
        const v = JSON.parse(process.env.PI_VIDA_HERDR_JSON);
        process.stdout.write(String(v?.result?.pane?.pane_id ?? ""));
      } catch {}
    ' 2>/dev/null || true)"
    if [[ -z "${pane_id}" ]]; then
      printf 'pi-vida: herdr pane split returned no pane_id for %s: %s\n' "${member}" "${out}" >&2
      exit 2
    fi
    out="$(herdr agent start "${member}" --kind pi --pane "${pane_id}" -- pi-vida "${life}" solo 2>&1)" || {
      printf 'pi-vida: herdr agent start failed for %s: %s\n' "${member}" "${out}" >&2
      exit 2
    }
    prev_pane="${pane_id}"
    direction="down"
  done
  PI_HERDR_MEMBERS="$(IFS=,; echo "${members[*]}")"
}

launch_life() {
  local root="$1" life="$2" mode="$3" dry_run="$4" fusion_stack="${5:-}"
  fusion_stack_used="${fusion_stack}"
  collect_launch_args "${root}" "${life}" "${mode}"
  if [[ "${mode}" == "fusion" ]]; then
    # The stack's primary slot becomes the host model at startup; a solo
    # override would only churn the session before the switch — warn + drop.
    if [[ -n "${solo_model}" || -n "${solo_thinking}" ]]; then
      doctor_warn "fusion mode: solo model/thinking dropped (stack primary is the host model)"
    fi
  else
    [[ -n "${solo_model}" ]] && pi_args+=(--model "${solo_model}")
    [[ -n "${solo_thinking}" ]] && pi_args+=(--thinking "${solo_thinking}")
  fi

  # Issue #79 (INV-herdr): team mode inside Herdr starts one pane per member
  # and the primary becomes the dispatcher pane. Fail closed: any pane/agent
  # failure prints stderr and exits 2 — never a hidden-child fallback in the
  # same session. Created panes stay open so the user can reuse them.
  if [[ "${mode}" == "team" && "${HERDR_ENV:-}" == "1" ]]; then
    start_herdr_team "${root}" "${life}"
    export PI_HERDR_MEMBERS
  fi

  if [[ "${dry_run}" -eq 1 ]]; then
    printf 'pi'
    local arg
    for arg in "${pi_args[@]}"; do
      printf ' %q' "${arg}"
    done
    printf '\n'
    # Diagnostics on stderr (doctor's convention): the resolved overlay env
    # is part of the launch contract — children dispatch models from it.
    printf 'PI_OVERLAY=%s\n' "${PI_OVERLAY}" >&2
    return 0
  fi

  if ! command -v pi >/dev/null 2>&1; then
    printf 'pi-vida: pi not found on PATH\n' >&2
    exit 127
  fi

  exec pi "${pi_args[@]}"
}

main() {
  local dry_run=0
  if [[ "${1:-}" == "--dry-run" ]]; then
    dry_run=1
    shift
  fi

  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi
  if [[ "${1}" == "-h" || "${1}" == "--help" || "${1}" == "help" ]]; then
    if [[ $# -ne 1 ]]; then
      printf 'pi-vida: unexpected argument: %s\n' "${2}" >&2
      usage >&2
      exit 2
    fi
    usage
    exit 0
  fi

  local root
  root="$(resolve_root)"

  case "${1}" in
    doctor)
      # Issue #13: doctor checks the launcher + optional packs. Exit 2 if a
      # required piece (pi, bun) is missing or the overlay fails to parse;
      # optional gaps (packs, just, rs-guard, excludesfile) warn, exit 0.
      if [[ $# -gt 2 ]]; then
        printf 'pi-vida: unexpected argument: %s\n' "${3}" >&2
        usage >&2
        exit 2
      fi
      local doc_arg="${2:-}"
      local doc_life=""
      if [[ -n "${doc_arg}" ]]; then
        local doc_status=0
        doc_life="$(canonical_life "${doc_arg}")" || doc_status=$?
        if [[ "${doc_status}" -eq 2 ]]; then
          exit 2
        fi
        if [[ "${doc_status}" -ne 0 ]]; then
          printf 'pi-vida: unknown vida %s\n' "${doc_arg}" >&2
          usage >&2
          exit 2
        fi
        printf 'vida: %s\n' "${doc_life}"
      fi
      printf 'harness: %s\n' "${root}"
      printf 'cwd: %s\n' "${PWD}"

      # Check required launcher pieces BEFORE read_overlay: it spawns bun, so
      # a missing bun must surface as a clean "required: FAIL missing: bun",
      # not as an opaque failure inside the overlay read.
      local missing=()
      command -v pi >/dev/null 2>&1 || missing+=("pi")
      command -v bun >/dev/null 2>&1 || missing+=("bun")
      if [[ ${#missing[@]} -gt 0 ]]; then
        printf 'required: FAIL missing: %s\n' "${missing[*]}"
        exit 2
      fi
      printf 'required: ok\n'

      local overlay
      overlay="$(read_overlay "${PWD}")" || exit 2
      printf 'overlay: %s\n' "${overlay}"

      local optional=0
      local skills_home="${PI_SKILLS_HOME:-${HOME}/.agents/skills}"
      if [[ -n "${doc_life}" ]]; then
        doctor_check_life "${doc_life}" 1 "${skills_home}" "${root}"
      else
        # No vida argument: sweep every profile and warn (never fail) on
        # missing skills — a bare `doctor` must not report "required: ok"
        # while a launch would exit 2. `doctor <vida>` stays fail-closed;
        # the sweep is advisory because users may only run a subset of
        # vidas. Deduped: one warning per skill, lives listed.
        local sweep_profile sweep_name
        local -A sweep_missing=()
        for sweep_profile in "${root}"/profiles/*.yaml; do
          [[ -e "${sweep_profile}" ]] || continue
          sweep_name="${sweep_profile##*/}"; sweep_name="${sweep_name%.yaml}"
          doctor_check_life "${sweep_name}" 0 "${skills_home}" "${root}"
        done
        local sweep_key
        for sweep_key in "${!sweep_missing[@]}"; do
          doctor_warn "missing ${sweep_key} (vidas: ${sweep_missing[${sweep_key}]% }) — run just skills"
          optional=$((optional + 1))
        done
      fi

      if ! command -v just >/dev/null 2>&1; then
        doctor_warn "just not on PATH"
        optional=$((optional + 1))
      fi
      if ! command -v rs-guard >/dev/null 2>&1; then
        doctor_warn "rs-guard not on PATH"
        optional=$((optional + 1))
      fi
      # open-code-review (ocr) is the default interactive review tool. The
      # npm package is @alibaba-group/open-code-review; `npx -y` runs it
      # without a global install, so either ocr or npx satisfies the check.
      if ! command -v ocr >/dev/null 2>&1 && ! command -v npx >/dev/null 2>&1; then
        doctor_warn "ocr not on PATH and npx unavailable (run via: npx -y @alibaba-group/open-code-review)"
        optional=$((optional + 1))
      fi
      # Issue #19: herdr is the daily host for parallel pi-vida sessions.
      # Optional: the harness works without it; the herdr skill no-ops when
      # HERDR_ENV is unset, so a plain terminal is unaffected.
      if ! command -v herdr >/dev/null 2>&1; then
        doctor_warn "herdr not on PATH"
        optional=$((optional + 1))
      fi
      # Fusion mode needs the vendored extension; missing = broken checkout.
      if [[ ! -f "${root}/extensions/fusion-harness/fusion-harness.ts" ]]; then
        doctor_warn "fusion extension missing (${root}/extensions/fusion-harness/)"
        optional=$((optional + 1))
      fi
      local ex_rc=0
      local ex_out
      ex_out="$(check_excludesfile 2>&1)" || ex_rc=$?
      if [[ "${ex_rc}" -ne 0 ]]; then
        doctor_warn "${ex_out}"
        optional=$((optional + 1))
      fi
      if [[ "${optional}" -eq 0 ]]; then
        printf 'optional: ok\n'
      else
        printf 'optional: %s warning(s)\n' "${optional}"
      fi
      exit 0
      ;;
    doctor-probe)
      if [[ $# -ne 1 ]]; then
        printf 'pi-vida: unexpected argument: %s\n' "${2}" >&2
        usage >&2
        exit 2
      fi
      check_excludesfile
      exit $?
      ;;
    agents)
      # Issue #81: print the resolved agents view for cwd + vida — winner,
      # shadows, team, chain file, both discovery orders, and the resolved
      # skill paths. Reuses collect_launch_args so the skill list comes from
      # the exact code path launch uses (same resolver by construction).
      # Missing mantra/tracker exit 2 and missing-pack warnings inherit
      # add_named_skill — identical to launch, intentionally.
      if [[ $# -gt 2 ]]; then
        printf 'pi-vida: unexpected argument: %s\n' "${3}" >&2
        usage >&2
        exit 2
      fi
      local agents_raw="${2:-${PI_VIDA:-${PI_LIFE:-}}}"
      if [[ -z "${agents_raw}" ]]; then
        printf 'pi-vida: agents requires a vida argument\n' >&2
        usage >&2
        exit 2
      fi
      local agents_status=0
      local agents_life
      agents_life="$(canonical_life "${agents_raw}")" || agents_status=$?
      if [[ "${agents_status}" -eq 2 ]]; then
        exit 2
      fi
      if [[ "${agents_status}" -ne 0 ]]; then
        printf 'pi-vida: unknown vida %s\n' "${agents_raw}" >&2
        usage >&2
        exit 2
      fi
      local agents_root
      # Command substitution is the fail-closed mechanism (same convention as
      # the overlay_extras capture below/above): a failed resolve_root cannot
      # flow into a confusing secondary "missing profile" error.
      agents_root="$(resolve_root)" || exit 2
      collect_launch_args "${agents_root}" "${agents_life}" solo
      # Load agents-view.ts from the resolved harness root (PI_VIDA_HOME et al
      # honored) so the module, the resolver, and launch all see one tree.
      bun "${agents_root}/extensions/agents-view.ts" "${PWD}" "${agents_life}" || exit 2
      local skill_arg next_is_skill=0
      for skill_arg in "${pi_args[@]}"; do
        if [[ "${next_is_skill}" -eq 1 ]]; then
          printf 'skill: %s\n' "${skill_arg}"
          next_is_skill=0
        elif [[ "${skill_arg}" == "--skill" ]]; then
          next_is_skill=1
        fi
      done
      exit 0
      ;;
    --dump-overlay)
      # Print the overlay for <cwd> as a single JSON line on stdout. Used by
      # smoke tests and by `pi-vida doctor` (issue #13) to introspect the
      # resolved overlay without launching Pi. Exits 2 on bad YAML or schema.
      if [[ $# -ne 2 ]]; then
        printf 'pi-vida: --dump-overlay requires a cwd argument\n' >&2
        usage >&2
        exit 2
      fi
      read_overlay "${2}"
      exit $?
      ;;
  esac

  local life status=0
  life="$(canonical_life "${1}")" || status=$?
  if [[ "${status}" -eq 2 ]]; then
    exit 2
  fi
  if [[ "${status}" -ne 0 ]]; then
    printf 'pi-vida: unknown vida %s\n' "${1}" >&2
    usage >&2
    exit 2
  fi

  local mode="${2:-solo}"
  local fusion_stack=""
  case "${mode}" in
    solo|team|chain)
      if [[ $# -gt 2 ]]; then
        printf 'pi-vida: unexpected argument: %s\n' "${3}" >&2
        usage >&2
        exit 2
      fi
      ;;
    fusion)
      fusion_stack="${3:-}"
      if [[ -z "${fusion_stack}" || $# -gt 3 ]]; then
        printf 'pi-vida: fusion requires exactly one stack file: pi-vida %s fusion <stack.yaml>\n' "${1}" >&2
        usage >&2
        exit 2
      fi
      ;;
    *)
      printf 'pi-vida: unknown mode %s\n' "${mode}" >&2
      usage >&2
      exit 2
      ;;
  esac

  launch_life "${root}" "${life}" "${mode}" "${dry_run}" "${fusion_stack}"
}

main "$@"
